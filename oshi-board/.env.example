# このファイルを .env.local にコピーしてキーを入れてください。
# 未設定のものはデモデータで動きます。

# YouTube Data API v3 のAPIキー（配信中/予定の判定と、Holodex が無いときの切り抜き検索に使用）
YOUTUBE_API_KEY=
# 切り抜き検索（search.list）を1日に何回まで使うか（既定 80。YouTube 側の上限は1日100回程度）
YOUTUBE_SEARCH_DAILY_LIMIT=80

# Twitch アプリの Client ID / Client Secret（配信中・予定・クリップの取得に使用）
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google ログインで YouTube の登録チャンネルを取り込む場合の OAuth クライアント（任意。README 参照）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Holodex のAPIキー（任意。あると VTuber の切り抜きと「見つける」の VTuber 一覧が使える）
HOLODEX_API_KEY=
# Holodex で取得する切り抜きの言語（カンマ区切り。例: ja,en）
HOLODEX_CLIP_LANG=ja

# 公開URL（任意。プロキシの後ろで動かすとき、ログインのリダイレクトURLの組み立てに使う）
# APP_URL=https://board.example.com

# 自分のサーバーで動かすときの接続元IPの取り方（API の回数制限用。Vercel 上では使わない）
# プロキシが必ず上書きするヘッダーだけを指定すること（README の「デプロイ」参照）
# TRUSTED_IP_HEADER=x-real-ip
# TRUST_PROXY_HOPS=1
